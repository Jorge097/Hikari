APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Correos con acceso a /panel_hikari, separados por coma
ADMIN_EMAILS=

# Stripe (sk_test_... en local; sk_live_... solo en producción)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Hikari: IVA y envío nacional (centavos)
HIKARI_TAX_RATE=0.16
HIKARI_PRICES_INCLUDE_TAX=true
HIKARI_SHIPPING_NATIONAL_CENTS=0

# Cierre mensual: destinatarios separados por coma
HIKARI_REPORT_EMAILS=
APP_TIMEZONE=America/Mexico_City

# Aviso de privacidad: datos del responsable
HIKARI_PRIVACY_RESPONSIBLE=
HIKARI_PRIVACY_ADDRESS=
HIKARI_PRIVACY_EMAIL=
HIKARI_PRIVACY_PHONE=

# Facturación CFDI (Facturama API Web; el CSD se sube en su portal)
FACTURAMA_USER=
FACTURAMA_PASSWORD=
FACTURAMA_SANDBOX=true
HIKARI_CFDI_EXPEDITION_PLACE=
HIKARI_CFDI_SERIE=HK
HIKARI_CFDI_PRODUCT_CODE=01010101
HIKARI_CFDI_SHIPPING_CODE=78102203

# Producción: SESSION_SECURE_COOKIE=true y APP_DEBUG=false

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
